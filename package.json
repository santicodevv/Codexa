{
  "name": "codexa",
  "version": "0.1.0",
  "private": true,
  "description": "Codexa — Auditoría de código con IA (monorepo npm workspaces)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:packages && npm run build:api && npm run build:cli && npm run build:web",
    "build:packages": "npm run build --workspace @codexa/contracts --workspace @codexa/analysis --workspace @codexa/ai --workspace @codexa/cli-core",
    "build:api": "npm run build --workspace apps/api",
    "build:cli": "npm run build --workspace apps/cli",
    "build:web": "npm run build --workspace apps/frontend",
    "dev:api": "npm run build:packages && npm run start:dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/frontend",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --config jest.config.cjs",
    "test:watch": "jest --config jest.config.cjs --watch",
    "test:e2e": "npm run test:e2e --workspace apps/api",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force && npm run db:seed"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "ts-node --project tsconfig.base.json prisma/seed.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.14",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "prisma": "^5.22.0",
    "ts-jest": "^29.2.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.3.0"
  }
}
