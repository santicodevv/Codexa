generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  passwordHash    String           @map("password_hash")
  displayName     String?          @map("display_name")
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at")
  repositories    Repository[]
  refreshTokens   RefreshToken[]
  triggeredAudits Audit[]          @relation("TriggeredAudits")

  @@map("users")
}

model RefreshToken {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  tokenHash         String    @unique @map("token_hash")
  expiresAt         DateTime  @map("expires_at")
  revoked           Boolean   @default(false)
  replacedByTokenId String?   @map("replaced_by_token_id")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
  @@index([userId], map: "idx_refresh_tokens_user")
}

model Repository {
  id           String     @id @default(uuid())
  ownerId      String     @map("owner_id")
  name         String
  provider     String
  url          String
  localPath    String?    @map("local_path")
  metadata     Json?      @default("{}")
  ciApiKeyHash String?    @unique @map("ci_api_key_hash")
  createdAt    DateTime   @default(now()) @map("created_at")
  lastAuditAt  DateTime?  @map("last_audit_at")
  owner        User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  audits       Audit[]

  @@map("repositories")
  @@unique([ownerId, provider, url], map: "uq_repositories_owner_provider_url")
  @@index([ownerId], map: "idx_repositories_owner")
}

model Audit {
  id                 String        @id @default(uuid())
  repositoryId       String        @map("repository_id")
  triggeredBy        String        @map("triggered_by")
  status             String        @default("pending")
  commitSha          String?       @map("commit_sha")
  provider           String?
  modelName          String?       @map("model")
  healthScore        Int?          @map("health_score")
  criticalCount      Int?          @map("critical_count")
  mediumCount        Int?          @map("medium_count")
  lowCount           Int?          @map("low_count")
  estimatedDebtHours Decimal?      @map("estimated_debt_hours") @db.Decimal(12, 6)
  totalFindings      Int?          @map("total_findings")
  durationMs         Int?          @map("duration_ms")
  startedAt          DateTime?     @map("started_at")
  completedAt        DateTime?     @map("completed_at")
  errorMessage       String?       @map("error_message")
  repository         Repository    @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  triggeredByUser    User          @relation("TriggeredAudits", fields: [triggeredBy], references: [id], onDelete: Restrict)
  findings           Finding[]
  aiSuggestions      AiSuggestion[]
  moduleSummaries    ModuleSummary[]
  llmUsages          LlmUsage[]

  @@map("audits")
  @@index([repositoryId, startedAt(sort: Desc)], map: "idx_audits_repository_started")
}

model Finding {
  id           String   @id @default(uuid())
  auditId      String   @map("audit_id")
  ruleId       String   @map("rule_id")
  severity     String
  likelihood   Float?
  message      String
  filePath     String   @map("file_path")
  lineNumber   Int?     @map("line_number")
  columnNumber Int?     @map("column_number")
  metadata     Json?    @default("{}")
  status       String   @default("open")
  audit        Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@map("findings")
  @@index([auditId, severity], map: "idx_findings_audit_severity")
  @@index([auditId, filePath], map: "idx_findings_audit_file")
}

model AiSuggestion {
  id             String   @id @default(uuid())
  auditId        String   @map("audit_id")
  type           String
  title          String
  description    String
  targetFile     String?  @map("target_file")
  targetLine     Int?     @map("target_line")
  codeBlocks     Json?    @map("code_blocks") @default("[]")
  modelReasoning String?  @map("model_reasoning")
  createdAt      DateTime @default(now()) @map("created_at")
  audit          Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@map("ai_suggestions")
  @@index([auditId], map: "idx_ai_suggestions_audit")
}

model ModuleSummary {
  id           String @id @default(uuid())
  auditId      String @map("audit_id")
  moduleName   String @map("module_name")
  moduleScore  Int    @map("module_score")
  findingCount Int    @map("finding_count")
  breakdown    Json?  @default("{}")
  audit        Audit  @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@map("module_summaries")
  @@index([auditId], map: "idx_module_summaries_audit")
}

model LlmUsage {
  id            String    @id @default(uuid())
  auditId       String    @map("audit_id")
  provider      String
  modelName     String    @map("model")
  inputTokens   Int       @map("input_tokens")
  outputTokens  Int       @map("output_tokens")
  estimatedCost Decimal?  @map("estimated_cost") @db.Decimal(12, 6)
  latencyMs     Int?      @map("latency_ms")
  createdAt     DateTime  @default(now()) @map("created_at")
  audit         Audit     @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@map("llm_usages")
  @@index([auditId], map: "idx_llm_usages_audit")
}
